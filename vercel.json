{
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/mercado",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/avisos",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/semana",
      "schedule": "0 20 * * 5"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
